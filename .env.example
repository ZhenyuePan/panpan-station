# Go serves the API and web/dist on the same origin.
PANPAN_ADDR=127.0.0.1:18080
PANPAN_DATA=.data
PANPAN_STATIC=web/dist
PANPAN_IMPORT_DIR=legacy-content
PANPAN_SITE_URL=http://127.0.0.1:18080
# Optional: a long random admin key. When empty, one is generated in .data/admin.key.
PANPAN_ADMIN_KEY=
# Configure after registering your QQ Connect website application.
QQ_APP_ID=
QQ_APP_SECRET=
QQ_ADMIN_OPENID=
# Callback: https://your-domain/api/auth/qq/callback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
